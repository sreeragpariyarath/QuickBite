{
  "openapi": "3.0.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "AppController_getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "status": "ok",
                    "service": "auth-service",
                    "database": "up",
                    "timestamp": "2026-07-12T10:00:00.000Z"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable"
          }
        },
        "summary": "Service + database health check",
        "tags": [
          "health"
        ]
      }
    },
    "/auth/otp/request": {
      "post": {
        "description": "OTP expires in 5 minutes, single-use. Without MSG91 credentials the response includes devOtp for testing. Limit: 3 requests per phone per 15 minutes.",
        "operationId": "AuthController_requestOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "OTP sent",
                    "expiresInSeconds": 300,
                    "devOtp": "123456"
                  }
                }
              }
            }
          },
          "429": {
            "description": "More than 3 requests in 15 minutes for this phone"
          }
        },
        "summary": "Send a 6-digit OTP to a phone (primary auth flow)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/otp/verify": {
      "post": {
        "operationId": "AuthController_verifyOtp",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyOtpDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "accessToken": "eyJhbGciOiJIUzI1NiIs…",
                    "refreshToken": "1961487d8735bfc1718…",
                    "isNewUser": true,
                    "user": {
                      "id": "8f8ca54f-ed93-46b9-837d-8c158588303a",
                      "phone": "+919876543210",
                      "role": "CUSTOMER"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid, expired, or already-used OTP; or attempt limit hit"
          }
        },
        "summary": "Verify OTP — logs in, auto-registers unknown phones",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/register/email": {
      "post": {
        "description": "Creates an unverified account and emails a verification link (24h expiry). Does NOT log the user in. Without RESEND_API_KEY the response includes devVerificationUrl for testing.",
        "operationId": "AuthController_registerEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterEmailDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Verification email sent."
                  }
                }
              }
            }
          },
          "409": {
            "description": "Email already registered"
          }
        },
        "summary": "Register with email + password",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/verify-email": {
      "get": {
        "description": "Single-use token. Email-first users get a refresh_token HttpOnly cookie (auto-login). Phone users who attached an email keep their existing session — no new tokens.",
        "operationId": "AuthController_verifyEmail",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "query",
            "description": "Raw verification token from the email link",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to FRONTEND_URL/auth/verified"
          },
          "401": {
            "description": "Link invalid, expired, or already used"
          }
        },
        "summary": "Verify email from the link — redirects, auto-login for email-first users",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/login/email": {
      "post": {
        "operationId": "AuthController_loginEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "accessToken": "eyJhbGciOiJIUzI1NiIs…",
                    "refreshToken": "1961487d8735bfc1718…"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password"
          },
          "409": {
            "description": "Please verify your email."
          }
        },
        "summary": "Login with email + password (verified email required)",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/email/resend": {
      "post": {
        "operationId": "AuthController_resendVerification",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Verification email sent."
                  }
                }
              }
            }
          },
          "404": {
            "description": "No account with this email"
          },
          "409": {
            "description": "Email is already verified"
          },
          "429": {
            "description": "Wait 60 seconds between resends"
          }
        },
        "summary": "Resend the verification email",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/me/email": {
      "patch": {
        "description": "Sets email + password (password only if none exists) and sends a verification link. The current session stays valid — no new tokens are issued.",
        "operationId": "AuthController_attachEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttachEmailDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Verification email sent."
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          },
          "409": {
            "description": "Account already has an email, or email is taken"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Attach an email to the logged-in (phone) account",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "description": "Reads the token from the body, or from the refresh_token HttpOnly cookie when the body is empty.",
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "accessToken": "eyJhbGciOiJIUzI1NiIs…"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Refresh token missing, invalid, or expired"
          }
        },
        "summary": "Exchange refresh token for a new access token",
        "tags": [
          "auth"
        ]
      }
    },
    "/auth/logout": {
      "post": {
        "description": "Accepts the token from the body or the refresh_token cookie; clears the cookie.",
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "message": "Logged out successfully"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid access token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke the refresh token",
        "tags": [
          "auth"
        ]
      }
    }
  },
  "info": {
    "title": "QuickBite API — Auth Service",
    "description": "QuickBite Backend Documentation. Phone OTP is the primary authentication flow; email + password is secondary.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RequestOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+919876543210",
            "description": "Indian mobile number in +91XXXXXXXXXX format"
          }
        },
        "required": [
          "phone"
        ]
      },
      "VerifyOtpDto": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "example": "+919876543210",
            "description": "Indian mobile number in +91XXXXXXXXXX format"
          },
          "otp": {
            "type": "string",
            "example": "123456",
            "description": "6-digit code from SMS"
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "OWNER"
            ],
            "default": "CUSTOMER",
            "description": "Applied only when the phone is not registered yet"
          }
        },
        "required": [
          "phone",
          "otp"
        ]
      },
      "RegisterEmailDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John"
          },
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "minLength": 8
          },
          "role": {
            "type": "string",
            "enum": [
              "CUSTOMER",
              "OWNER"
            ],
            "default": "CUSTOMER"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "customer@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResendVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "AttachEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123!",
            "minLength": 8,
            "description": "Sets the account password so email login works. Ignored if the account already has a password."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "1961487d8735bfc171879d604d7cae57ab6b8c25c246c5d5…",
            "description": "Opaque refresh token from login or OTP verify. Optional when the refresh_token HttpOnly cookie is present."
          }
        }
      }
    }
  }
}